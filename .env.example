OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=...
LLM_BACKEND=openai
COLLECTION_NAME=b2b_docs
DOCS_PATH=./docs
CHROMA_PATH=./chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
LOG_DIR=./logs
LOG_LEVEL=INFO
CHAT_DB_PATH=./chat_history.db
# Space-separated origins allowed to embed the /widget route, or * for any
WIDGET_ALLOWED_ORIGINS=*
# Comma-separated CORS origins for the FastAPI backend.
# In production, set this to your Vercel URL (e.g. https://myapp.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Secret key required in X-Widget-Key header for /api/chat requests.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WIDGET_API_KEY=
# Rate limit for /api/chat per IP (slowapi format, e.g. "5/minute", "20/hour")
CHAT_RATE_LIMIT=5/minute
# FastAPI backend URL used server-side by NextAuth to verify credentials.
# In production (Render), set this to your Render service URL.
BACKEND_URL=http://localhost:8000
