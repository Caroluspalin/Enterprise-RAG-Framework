# --- Secrets ---
.env
*.env
start.txt

# --- Python virtual environment ---
.venv/
venv/
env/

# --- Python caches ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.mypy_cache/
.ruff_cache/

# --- Local data ---
# Vector store can be large and is rebuilt with: python src/ingest.py
chroma_db/

# SQLite chat history database
*.db

# PDF documents may contain sensitive B2B data — never commit them.
# Covers both docs/ (CLI ingest) and src/docs/ (API upload when run from src/).
docs/*.pdf
src/docs/*.pdf

# --- Logs ---
logs/

# --- Evaluation reports ---
logs/eval_*.txt

# --- macOS ---
.DS_Store
.AppleDouble

# --- Next.js frontend ---
frontend/.next/
frontend/node_modules/
frontend/.env.local
frontend/.env*.local

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
