# Add a docs/.gitkeep if you want the empty folder tracked.
docs/*.pdf

# --- Logs ---
logs/

# --- Evaluation reports ---
logs/eval_*.txt

# --- macOS ---
.DS_Store
.AppleDouble

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
